<%- include('./head.ejs') %>

<div class="main">
  <% messages.forEach((message) => { %>
    <div>
      <a class="message" href="/msg/<%= message.id %>">
        <div class="namecontainer">
          <p class="username"><%= message.username %></p>
          <p class="time"><%= formatDate(message.created_at) %></p>
        </div>
        <p class="text"><%= message.msg %></p>
      </a>
    </div>
  <% }); %>
</div>

<%- include('./footer.ejs') %>
